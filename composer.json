{
  "name": "aguilardc/moggie",
  "type": "library",
  "description": "Moggie PHP - A high-performance micro framework for building RESTful APIs. Designed to compete with Lumen while offering superior performance and developer experience.",
  "keywords": [
    "microframework",
    "api",
    "restful",
    "php",
    "framework",
    "high-performance",
    "lightweight",
    "jwt",
    "routing",
    "middleware",
    "dependency-injection",
    "validation",
    "query-builder"
  ],
  "license": "MIT",
  "version": "2.0.0",
  "homepage": "https://github.com/aguilardc/MoggiePHP",
  "support": {
    "issues": "https://github.com/aguilardc/MoggiePHP/issues",
    "source": "https://github.com/aguilardc/MoggiePHP",
    "docs": "https://github.com/aguilardc/MoggiePHP/wiki"
  },
  "authors": [
    {
      "name": "Nevison Aguilar",
      "email": "aguilardc1105@gmail.com",
      "homepage": "https://github.com/aguilardc/",
      "role": "Lead Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "psr/container": "^2.0",
    "psr/http-message": "^2.0",
    "psr/http-server-middleware": "^1.0",
    "psr/simple-cache": "^3.0",
    "psr/log": "^3.0",
    "nikic/fast-route": "^1.3",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^6.8",
    "symfony/console": "^7.0",
    "monolog/monolog": "^3.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "pestphp/pest": "^2.28",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.45",
    "mockery/mockery": "^1.6",
    "symfony/var-dumper": "^7.0",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "Moggie\\": "src/",
      "App\\": "app/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Moggie\\Tests\\": "tests/",
      "App\\Tests\\": "tests/app/"
    }
  },
  "scripts": {
    "test": "pest",
    "test:unit": "pest --testsuite=Unit",
    "test:feature": "pest --testsuite=Feature",
    "test:coverage": "pest --coverage --min=80",
    "analyse": "phpstan analyse",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "quality": [
      "@format:check",
      "@analyse",
      "@test"
    ],
    "post-autoload-dump": [
      "@php -r \"file_exists('bootstrap/cache') || mkdir('bootstrap/cache', 0755, true);\""
    ]
  },
  "suggest": {
    "ext-redis": "Required for Redis cache driver",
    "ext-memcached": "Required for Memcached cache driver",
    "doctrine/dbal": "For advanced database operations and migrations",
    "illuminate/database": "For Eloquent ORM compatibility",
    "guzzlehttp/guzzle": "For HTTP client functionality",
    "league/flysystem": "For filesystem abstraction",
    "predis/predis": "Pure PHP Redis client"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.0-dev"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "bin": [
    "bin/moggie"
  ]
}
